datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
  SAFE_MODE
}

enum RewardEventStatus {
  STARTED
  VERIFIED
  REJECTED
  EXPIRED
  DUPLICATE
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum TransactionType {
  REWARD
  WITHDRAWAL_RESERVE
  WITHDRAWAL_REFUND
  ADMIN_ADJUSTMENT
}

model User {
  id           String        @id @default(uuid())
  username     String        @unique
  email        String        @unique
  passwordHash String
  coins        BigInt        @default(0)
  role         Role          @default(USER)
  status       AccountStatus @default(ACTIVE)
  riskScore    Int           @default(0) // 0 - 100
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lastLoginAt  DateTime      @default(now())

  rewardEvents     RewardEvent[]
  coinTransactions CoinTransaction[]
  withdrawals      Withdrawal[]
  riskEvents       RiskEvent[]

  @@index([status])
  @@index([riskScore])
}

model RewardConfig {
  id                    Int      @id @default(1)
  rewardAmount          BigInt   @default(10)
  dailyLimit            BigInt   @default(100)
  cooldownSeconds       BigInt   @default(15)
  isWatchAndEarnEnabled Boolean  @default(true)
  isKillSwitchActive    Boolean  @default(false)
  updatedAt             DateTime @updatedAt
  lastUpdatedBy         String   @default("SYSTEM")
}

model RewardEvent {
  id                 String            @id @default(uuid())
  userId             String
  idempotencyKey     String            @unique
  status             RewardEventStatus
  rewardAmount       BigInt
  verificationStatus String
  riskInfo           String
  createdAt          DateTime          @default(now())
  verifiedAt         DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model CoinTransaction {
  id           String          @id @default(uuid())
  userId       String
  amount       BigInt
  type         TransactionType
  referenceId  String
  description  String
  balanceAfter BigInt
  createdAt    DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([referenceId])
}

model Withdrawal {
  id             String           @id @default(uuid())
  userId         String
  amount         BigInt
  paymentMethod  String
  paymentDetails String
  status         WithdrawalStatus @default(PENDING)
  adminNote      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String
  actorUsername String
  action        String
  targetType    String
  targetId      String
  metadata      String
  createdAt     DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action])
  @@index([targetId])
}

model RiskEvent {
  id            String   @id @default(uuid())
  userId        String
  previousScore Int
  newScore      Int
  reason        String
  severity      String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
